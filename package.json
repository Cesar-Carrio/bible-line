{
  "engines": {
    "node": ">=20.6.0"
  },
  "name": "bible-line",
  "version": "1.0.0",
  "description": "A beautiful terminal application that displays random Bible chapters with colorful formatting. Perfect for daily inspiration and devotions.",
  "main": "dist/index.js",
  "bin": {
    "bible-line": "./dist/index.js"
  },
  "keywords": [
    "bible",
    "terminal",
    "cli",
    "devotional",
    "scripture",
    "kjv",
    "random",
    "verse",
    "inspiration",
    "christian",
    "daily",
    "executable"
  ],
  "homepage": "https://github.com/cesar-carrio/bible-line#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesar-carrio/bible-line.git"
  },
  "bugs": {
    "url": "https://github.com/cesar-carrio/bible-line/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-data.js",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Cesar J. Carrillo <software-engineer@cesarjcarrillo.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.17",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/blessed": "^0.1.25",
    "blessed": "^0.1.81",
    "colors": "^1.4.0"
  }
}
